# Please do not directly edit this file. Instead, modify the .env variables related to NGINX configuration.

server {
    listen ${NGINX_PORT};
    server_name ${NGINX_SERVER_NAME};

    location /console/api {
      proxy_pass http://api:${DIFY_PORT};
      include proxy.conf;
    }

    location /api {
      proxy_pass http://api:${DIFY_PORT};
      include proxy.conf;
    }

    location /v1 {
      proxy_pass http://api:${DIFY_PORT};
      include proxy.conf;
    }

    location /files {
      proxy_pass http://api:${DIFY_PORT};
      include proxy.conf;
    }

    # Next.js (basePath) canonical URL has no trailing slash; do not 301 /seanergy -> /seanergy/ or browsers loop with Next's 308 /seanergy/ -> /seanergy.
    location = / {
      return 302 ${DIFY_WEB_BASE_PATH};
    }

    location = ${DIFY_WEB_BASE_PATH} {
      proxy_pass http://web:3000${DIFY_WEB_BASE_PATH};
      include proxy.conf;
    }

    # Strip trailing slash before upstream so Next does not emit 308 (some browsers fail on /seanergy/ <-> /seanergy).
    location = ${DIFY_WEB_BASE_PATH}/ {
      rewrite ^.*$ ${DIFY_WEB_BASE_PATH} break;
      proxy_pass http://web:3000;
      include proxy.conf;
    }

    location ^~ ${DIFY_WEB_BASE_PATH}/ {
      proxy_pass http://web:3000${DIFY_WEB_BASE_PATH}/;
      include proxy.conf;
    }

    # Legacy root paths -> Next.js basePath
    location ^~ /explore {
      rewrite ^/explore(.*)$ ${DIFY_WEB_BASE_PATH}/explore$1 break;
      proxy_pass http://web:3000;
      include proxy.conf;
    }

    location ^~ /apps {
      rewrite ^/apps(.*)$ ${DIFY_WEB_BASE_PATH}/apps$1 break;
      proxy_pass http://web:3000;
      include proxy.conf;
    }

    location /e/ {
      proxy_pass http://plugin_daemon:5002;
      proxy_set_header Dify-Hook-Url $scheme://$host$request_uri;
      include proxy.conf;
    }

    # Non-prefixed paths are not valid once Next uses DIFY_WEB_BASE_PATH; avoid accidental proxy to wrong routes.
    location / {
      return 302 ${DIFY_WEB_BASE_PATH};
    }

    location /mcp {
      proxy_pass http://api:${DIFY_PORT};
      include proxy.conf;
    }

    location /triggers {
      proxy_pass http://api:${DIFY_PORT};
      include proxy.conf;
    }
    
    # placeholder for acme challenge location
    ${ACME_CHALLENGE_LOCATION}

    # placeholder for https config defined in https.conf.template
    ${HTTPS_CONFIG}
}
